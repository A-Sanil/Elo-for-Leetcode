{
  "manifest_version": 3,
  "name": "Elo for LeetCode",
  "version": "0.3.0",
  "description": "Ratings, a practice dashboard with problem memory and graphs, a roadmap, notes, focus mode, and next-problem picks.",
  "permissions": ["storage"],
  "host_permissions": ["https://leetcode.com/*"],
  "action": {
    "default_title": "Elo for LeetCode",
    "default_popup": "popup.html"
  },
  "background": { "service_worker": "worker.js" },
  "content_scripts": [{
    "matches": ["https://leetcode.com/*"],
    "js": ["model.js", "leetcode.js", "content.js"],
    "run_at": "document_idle"
  }]
}
